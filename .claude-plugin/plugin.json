{
  "name": "blind-env",
  "version": "0.1.0",
  "description": "A .env file for AI agents: Claude can use your secrets by name but never sees the values.",
  "author": {
    "name": "necromancer124"
  },
  "homepage": "https://github.com/necromancer124/blind-env",
  "repository": "https://github.com/necromancer124/blind-env",
  "license": "MIT",
  "keywords": ["secrets", "env", "mcp", "security"],
  "commands": "./.claude/commands/",
  "mcpServers": {
    "blind-env": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/src/cli.js", "mcp"],
      "env": {
        "BLIND_ENV_SKIP_DIR": "${CLAUDE_PLUGIN_ROOT}"
      }
    }
  }
}
